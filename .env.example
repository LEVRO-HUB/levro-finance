# Copy to .env.local and fill in. Never commit real values.
# Both are PUBLIC browser values from Supabase → Project Settings → API.
# Do NOT put the service-role / secret key here or in any VITE_ variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Leave both empty to run the local demo mode (browser storage, no sign-in).
